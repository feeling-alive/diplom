# FinTrack backend environment — copy to backend/.env and fill in.
# backend/.env is gitignored (root .gitignore covers .env / .env.*).

# Finnhub API key — get one at https://finnhub.io/dashboard
# NEVER commit the real key. The old key leaked into git history; rotate it.
FINNHUB_API_KEY=your_key_here

# Redis connection. Default matches `docker run -p 6379:6379 redis:alpine`.
REDIS_URL=redis://localhost:6379

# Comma-separated list of allowed CORS origins (the Vite dev server).
CORS_ORIGINS=http://localhost:5173

# Cache TTLs in seconds (optional — defaults shown).
STOCK_TTL=60
CRYPTO_TTL=30
FOREX_TTL=300

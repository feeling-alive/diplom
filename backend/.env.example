# FinTrack backend environment — copy to backend/.env and fill in.
# backend/.env is gitignored (root .gitignore covers .env / .env.*).

# Finnhub API key — get one at https://finnhub.io/dashboard
# NEVER commit the real key. The old key leaked into git history; rotate it.
FINNHUB_API_KEY=your_key_here

# Redis connection. Default matches `docker run -p 6379:6379 redis:alpine`.
REDIS_URL=redis://localhost:6379

# Database (asyncpg DSN). For a host-run uvicorn/alembic use host `localhost`;
# inside Docker Compose the backend service uses host `postgres` (set there).
DATABASE_URL=postgresql+asyncpg://fintrack:fintrack_pass@localhost:5432/fintrack

# Auth / JWT. CHANGE SECRET_KEY in production — never commit a real secret.
SECRET_KEY=your-secret-key-change-in-production
ALGORITHM=HS256
# Access token lifetime in minutes (default 7 days = 60*24*7 = 10080).
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Directory for uploaded files (e.g. avatars). Relative to backend/.
UPLOADS_DIR=uploads

# Comma-separated list of allowed CORS origins (the Vite dev server).
CORS_ORIGINS=http://localhost:5173

# Cache TTLs in seconds (optional — defaults shown).
STOCK_TTL=60
CRYPTO_TTL=30
FOREX_TTL=300

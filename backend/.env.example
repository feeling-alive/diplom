# FinTrack backend — пример переменных окружения.
# Скопируйте в backend/.env и заполните значения. .env не коммитится (в .gitignore).

# --- База данных (PostgreSQL, asyncpg DSN) -----------------------------------
# Для host-запуска uvicorn/alembic — localhost; внутри docker compose хост
# переопределяется на `postgres`. На этой машине host-порт = 5433.
DATABASE_URL=postgresql+asyncpg://fintrack:fintrack_pass@localhost:5432/fintrack

# --- Redis (кэш котировок, токены сброса пароля) ------------------------------
REDIS_URL=redis://localhost:6379

# --- JWT ----------------------------------------------------------------------
# ОБЯЗАТЕЛЬНО замените в production на случайную строку (например, openssl rand -hex 32).
SECRET_KEY=your-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# --- Service URLs ---------------------------------------------------------------
# FRONTEND_URL используется для ссылки в письме сброса пароля и OAuth-редиректов.
BACKEND_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173

# --- CORS -----------------------------------------------------------------------
CORS_ORIGINS=http://localhost:5173

# --- SMTP / Email (восстановление пароля) ---------------------------------------
# Если SMTP_HOST пуст — письма не отправляются, ссылка сброса пишется в DEBUG-лог
# (удобно для локальной разработки). Для Gmail: smtp.gmail.com:587 + app password.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@fintrack.local

# --- Google OAuth (пусто => /auth/google отдаёт 501) -----------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Admin panel — Fernet encryption key ----------------------------------------
# ОБЯЗАТЕЛЕН для сохранения API-ключей через /admin/api-keys.
# Сгенерировать: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# --- Внешние API-ключи ------------------------------------------------------------
# Все опциональны: при отсутствии соответствующий эндпоинт отдаёт fallback.
FINNHUB_API_KEY=
NEWS_API_KEY=
OPENROUTER_API_KEY=
ETHERSCAN_API_KEY=
GROQ_API_KEY=
